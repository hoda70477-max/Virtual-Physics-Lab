<Window x:Class="PhysLab.Views.SavedResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhysLab - Saved Results"
        Height="700"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,25">
            <TextBlock Text="Saved Results"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#14243A"/>

            <TextBlock Text="Review your previously saved physics experiments."
                       FontSize="15"
                       Foreground="#718096"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">

            <TextBlock x:Name="ExperimentsCountText"
                       Text="Saved Experiments: 0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#3478F6"/>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="SavedExperimentsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="55"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Experiment"
                                        Binding="{Binding ExperimentName}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Saved At"
                                        Binding="{Binding SavedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="Parameters"
                                        Binding="{Binding ParametersSummary}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Results"
                                        Binding="{Binding ResultsSummary}"
                                        Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="EmptyMessage"
                       Text="No saved experiments yet."
                       FontSize="18"
                       Foreground="#718096"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
