<Window x:Class="PhysLab.Views.ExperimentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhysLab - Experiments"
        Height="700"
        Width="950"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#14243A"
                Padding="30">

            <StackPanel>
                <TextBlock Text="PHYSICS EXPERIMENTS"
                           Foreground="White"
                           FontSize="27"
                           FontWeight="Bold"/>

                <TextBlock Text="Choose an experiment to start your simulation."
                           Foreground="#B8C7D9"
                           FontSize="14"
                           Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Experiments -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="30">

                <TextBlock Text="Available Experiments"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#14243A"
                           Margin="0,0,0,20"/>

                <UniformGrid Columns="2">

                    <!-- Pendulum -->
                    <Button Click="PendulumButton_Click"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,12,12"
                            HorizontalContentAlignment="Stretch">

                        <StackPanel>
                            <TextBlock Text="01"
                                       Foreground="#3478F6"
                                       FontSize="15"/>

                            <TextBlock Text="Simple Pendulum"
                                       Foreground="#14243A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,12,0,8"/>

                            <TextBlock Text="Calculate the time period of a simple pendulum."
                                       Foreground="#718096"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Spring -->
                    <Button Click="SpringButton_Click"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,12"
                            HorizontalContentAlignment="Stretch">

                        <StackPanel>
                            <TextBlock Text="02"
                                       Foreground="#3478F6"
                                       FontSize="15"/>

                            <TextBlock Text="Spring-Mass System"
                                       Foreground="#14243A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,12,0,8"/>

                            <TextBlock Text="Explore simple harmonic motion and angular frequency."
                                       Foreground="#718096"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Projectile -->
                    <Button Click="ProjectileButton_Click"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,12,12"
                            HorizontalContentAlignment="Stretch">

                        <StackPanel>
                            <TextBlock Text="03"
                                       Foreground="#3478F6"
                                       FontSize="15"/>

                            <TextBlock Text="Projectile Motion"
                                       Foreground="#14243A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,12,0,8"/>

                            <TextBlock Text="Calculate flight time, maximum height, and horizontal range."
                                       Foreground="#718096"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- Newton -->
                    <Button Click="NewtonButton_Click"
                            Background="White"
                            BorderBrush="#E1E8F0"
                            BorderThickness="1"
                            Padding="20"
                            Margin="0,0,0,12"
                            HorizontalContentAlignment="Stretch">

                        <StackPanel>
                            <TextBlock Text="04"
                                       Foreground="#3478F6"
                                       FontSize="15"/>

                            <TextBlock Text="Newton's Second Law"
                                       Foreground="#14243A"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,12,0,8"/>

                            <TextBlock Text="Study force, mass, acceleration, and momentum."
                                       Foreground="#718096"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
