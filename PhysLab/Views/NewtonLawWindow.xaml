<Window x:Class="PhysLab.Views.NewtonLawWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Newton's Second Law - PhysLab"
        Height="750"
        Width="1100"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Newton's Second Law"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#14243A"/>

            <TextBlock Text="Explore the relationship between force, mass, and acceleration."
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Input Panel -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="12"
                    Padding="22"
                    Margin="0,0,15,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>
                        <TextBlock Text="Experiment Parameters"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#14243A"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Mass (kg)"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="MassTextBox"
                                 Text="5"
                                 Height="38"
                                 Padding="8"
                                 Margin="0,7,0,15"/>

                        <TextBlock Text="Applied Force (N)"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ForceTextBox"
                                 Text="20"
                                 Height="38"
                                 Padding="8"
                                 Margin="0,7,0,15"/>

                        <TextBlock Text="Initial Velocity (m/s)"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="VelocityTextBox"
                                 Text="0"
                                 Height="38"
                                 Padding="8"
                                 Margin="0,7,0,20"/>

                        <Button Content="Calculate Results"
                                Height="42"
                                Background="#3478F6"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="CalculateButton_Click"/>

                        <TextBlock Text="Results"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#14243A"
                                   Margin="0,25,0,15"/>

                        <TextBlock Text="Acceleration"
                                   Foreground="#718096"/>

                        <TextBlock x:Name="AccelerationResult"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#3478F6"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="Momentum"
                                   Foreground="#718096"/>

                        <TextBlock x:Name="MomentumResult"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#3478F6"
                                   Margin="0,3,0,12"/>

                        <TextBlock Text="Weight"
                                   Foreground="#718096"/>

                        <TextBlock x:Name="WeightResult"
                                   Text="--"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#3478F6"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Simulation Panel -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Force Simulation"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#14243A"
                               Margin="0,0,0,15"/>

                    <Border Grid.Row="1"
                            Background="#F7F9FD"
                            CornerRadius="8"
                            ClipToBounds="True">

                        <Canvas x:Name="SimulationCanvas"
                                Background="#F7F9FD">

                            <!-- Ground -->
                            <Line X1="20" Y1="450"
                                  X2="650" Y2="450"
                                  Stroke="#718096"
                                  StrokeThickness="2"/>

                            <!-- Object -->
                            <Rectangle x:Name="MovingBlock"
                                       Width="65"
                                       Height="55"
                                       RadiusX="8"
                                       RadiusY="8"
                                       Fill="#3478F6"
                                       Canvas.Left="45"
                                       Canvas.Top="395"/>

                            <!-- Force Arrow -->
                            <Line x:Name="ForceArrowLine"
                                  X1="115" Y1="420"
                                  X2="185" Y2="420"
                                  Stroke="#F59E0B"
                                  StrokeThickness="4"/>

                            <Polygon x:Name="ForceArrowHead"
                                     Points="185,410 200,420 185,430"
                                     Fill="#F59E0B"/>
                        </Canvas>
                    </Border>

                    <!-- Start and Reset -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,15,0,10">

                        <Button x:Name="StartButton"
                                Content="Start"
                                Width="110"
                                Height="40"
                                Margin="5"
                                Background="#3478F6"
                                Foreground="White"
                                BorderThickness="0"
                                Click="StartButton_Click"/>

                        <Button Content="Reset"
                                Width="110"
                                Height="40"
                                Margin="5"
                                Background="#E8EDF5"
                                Foreground="#14243A"
                                BorderThickness="0"
                                Click="ResetButton_Click"/>
                    </StackPanel>

                    <!-- Save Result -->
                    <Button Grid.Row="3"
                            Content="Save Result"
                            Width="180"
                            Height="45"
                            HorizontalAlignment="Center"
                            Background="#16A36A"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="SaveButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
