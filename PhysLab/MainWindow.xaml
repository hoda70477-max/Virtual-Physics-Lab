<Window x:Class="PhysLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhysLab - Virtual Physics Laboratory"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#14243A"
                Padding="20">

            <StackPanel>
                <TextBlock Text="PHYSLAB"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0,10,0,40"/>

                <TextBlock Text="MAIN MENU"
                           Foreground="#8FA3BC"
                           FontSize="12"
                           Margin="0,0,0,15"/>

                <Button Content="Dashboard"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#29476B"
                        Foreground="White"
                        BorderThickness="0"/>

                <Button Content="Experiments"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ExperimentsButton_Click"/>

                <Button Content="Saved Results"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SavedResultsButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="35">

                <TextBlock Text="Welcome to PhysLab"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#14243A"/>

                <TextBlock Text="Your Virtual Physics Laboratory"
                           FontSize="15"
                           Foreground="#718096"
                           Margin="0,8,0,30"/>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="25"
                        Margin="0,0,0,20">

                    <StackPanel>
                        <TextBlock Text="Explore Physics"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#14243A"/>

                        <TextBlock Text="Run experiments, explore physical laws, and analyze results."
                                   Foreground="#718096"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Available Experiments"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#14243A"
                           Margin="0,10,0,20"/>

                <UniformGrid Columns="2">

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,12,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="PendulumCard_Click">
                        <StackPanel>
                            <TextBlock Text="01"
                                       FontSize="14"
                                       Foreground="#3478F6"/>
                            <TextBlock Text="Simple Pendulum"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,10,0,5"/>
                            <TextBlock Text="Study periodic motion and calculate time period."
                                       TextWrapping="Wrap"
                                       Foreground="#718096"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="SpringCard_Click">
                        <StackPanel>
                            <TextBlock Text="02"
                                       FontSize="14"
                                       Foreground="#3478F6"/>
                            <TextBlock Text="Spring-Mass System"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,10,0,5"/>
                            <TextBlock Text="Explore simple harmonic motion."
                                       TextWrapping="Wrap"
                                       Foreground="#718096"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,12,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="ProjectileCard_Click">
                        <StackPanel>
                            <TextBlock Text="03"
                                       FontSize="14"
                                       Foreground="#3478F6"/>
                            <TextBlock Text="Projectile Motion"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,10,0,5"/>
                            <TextBlock Text="Explore projectile trajectories and calculate range and height."
                                       TextWrapping="Wrap"
                                       Foreground="#718096"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,0,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="NewtonLawCard_Click">
                        <StackPanel>
                            <TextBlock Text="04"
                                       FontSize="14"
                                       Foreground="#3478F6"/>
                            <TextBlock Text="Newton's Second Law"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,10,0,5"/>
                            <TextBlock Text="Study the relationship between force, mass, and acceleration."
                                       TextWrapping="Wrap"
                                       Foreground="#718096"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
